# Copy to .env in the api/ folder.

PORT=3001
# Must match the Vite dev server origin (this project uses port 5174 by default)
CORS_ORIGIN=http://localhost:5174

# Supabase (when the real backend is wired)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Firebase Admin (alternative)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
