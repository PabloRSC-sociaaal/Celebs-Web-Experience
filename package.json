{
  "name": "celebs",
  "version": "0.1.0",
  "private": true,
  "description": "Celebs — Celebrity Doppelganger Platform",
  "scripts": {
    "dev":        "npm run dev --prefix web",
    "dev:api":    "npm run dev --prefix api",
    "dev:all":    "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build":      "npm run build --prefix web",
    "preview":    "npm run preview --prefix web",
    "install:all": "npm i --prefix web && npm i --prefix api && npm i --prefix functions",
    "setup": "npm install && npm run install:all"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
