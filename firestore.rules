rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own document but cannot write the subscription field
    // (only Cloud Functions can write subscription data via Admin SDK)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
