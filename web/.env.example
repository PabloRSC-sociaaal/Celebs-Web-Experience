# Copy to .env (never commit .env). Vite only exposes vars prefixed with VITE_.

# --- Lemon Squeezy (premium checkout) ---
VITE_LS_VARIANT_MONTHLY=
VITE_LS_VARIANT_ANNUAL=

# --- Optional: override Firebase client config (otherwise uses web/src/features/firebase/app.js) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# --- Optional: public app URL (defaults to window.location.origin) ---
# VITE_APP_URL=http://localhost:5174

# --- Feature flags (optional overrides; defaults in web/src/config/featureFlags.js) ---
# VITE_FF_DEMO_MODE=false
# VITE_FF_CAMINO=true
# VITE_FF_VIRAL_SHARE=true
# VITE_FF_SIMILARITY_EXPLORER=true
