# Copy to .env (never commit .env). Vite only exposes vars prefixed with VITE_.

# ── Backend HTTP base URL (REQUIRED outside of DEMO_MODE) ────────────────────
# Points at the `api` Express function exported by apps/functions/index.js.
# Production: https://us-central1-<project>.cloudfunctions.net/api
# Local dev (Firebase emulator): http://localhost:5001/<project>/us-central1/api
VITE_API_BASE_URL=

# ── Feature flags ────────────────────────────────────────────────────────────
# DEMO_MODE bypasses every backend call: mock auth, mock comparisons, no
# subscription listener. Set to false in production.
VITE_FF_DEMO_MODE=true
# VITE_FF_CAMINO=true
# VITE_FF_VIRAL_SHARE=true
# VITE_FF_SIMILARITY_EXPLORER=true

# ── Firebase web SDK config ──────────────────────────────────────────────────
# These are publishable values, not secrets, but the architecture document
# mandates they live in env (not hardcoded in source).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Lemon Squeezy variant IDs (premium checkout) ─────────────────────────────
VITE_LS_VARIANT_MONTHLY=
VITE_LS_VARIANT_ANNUAL=

# ── Optional ─────────────────────────────────────────────────────────────────
# VITE_APP_URL=http://localhost:5174
